      "tree": {
        "op": "bake",
        "detail": "325°F\n26–30 min (9\")\n38–42 min (8\")",
        "children": [
          {
            "op": "mix in",
            "detail": "slowly, low speed,\nscrape, until smooth",
            "children": [
              {
                "op": "mix",
                "detail": "low speed,\njust combined",
                "children": [
                  {
                    "op": "whisk",
                    "children": [
                      {
                        "item": "2 cups (240 g) all-purpose flour",
                        "note": "weigh, or spoon and sweep",
                        "name": "all-purpose flour",
                        "amount": 2,
                        "unit": "cups",
                        "metric": 240,
                        "metric_unit": "g"
                      },
                      {
                        "item": "1 1/4 tsp table salt",
                        "name": "table salt",
                        "amount": 1.25,
                        "unit": "tsp"
                      },
                      {
                        "item": "2 tsp baking powder",
                        "name": "baking powder",
                        "amount": 2,
                        "unit": "tsp"
                      }
                    ]
                  },
                  {
                    "op": "beat",
                    "detail": "2 min, med-high,\nthick and light gold",
                    "children": [
                      {
                        "item": "4 large eggs",
                        "note": "room temperature",
                        "name": "eggs",
                        "amount": 4,
                        "unit": "large"
                      },
                      {
                        "item": "2 cups (397 g) granulated sugar",
                        "name": "granulated sugar",
                        "amount": 2,
                        "unit": "cups",
                        "metric": 397,
                        "metric_unit": "g"
                      },
                      {
                        "item": "1 Tbs (14 g) vanilla extract",
                        "name": "vanilla extract",
                        "amount": 1,
                        "unit": "Tbs",
                        "metric": 14,
                        "metric_unit": "g"
                      },
                      {
                        "item": "1/8 tsp almond extract",
                        "note": "optional",
                        "name": "almond extract",
                        "amount": 0.125,
                        "unit": "tsp"
                      }
                    ]
                  }
                ]
              },
              {
                "op": "stir",
                "detail": "off heat,\nuntil melted",
                "children": [
                  {
                    "op": "heat",
                    "detail": "to a simmer",
                    "children": [
                      {
                        "item": "1 cup (227 g) whole milk",
                        "name": "whole milk",
                        "amount": 1,
                        "unit": "cup",
                        "metric": 227,
                        "metric_unit": "g"
                      }
                    ]
                  },
                  {
                    "item": "4 Tbs (57 g) butter",
                    "note": "cut into pats",
                    "name": "butter",
                    "amount": 4,
                    "unit": "Tbs",
                    "metric": 57,
                    "metric_unit": "g"
                  },
                  {
                    "item": "1/3 cup (67 g) vegetable oil",
                    "name": "vegetable oil",
                    "amount": 0.3333,
                    "unit": "cup",
                    "metric": 67,
                    "metric_unit": "g"
                  }
                ]
              }
            ]
          }
        ]
      },
      "finish": [
        "Divide batter evenly between the pans — about 2 3/4 cups (580 g) each",
        "Done at 205°F internal; cool 15 min in pans, turn out, cool completely"
      ]
