{
  "title": "Classic Birthday Cake",
  "tags": [
    "two layers",
    "hot-milk batter",
    "cocoa buttercream"
  ],
  "deck": "A tender yellow butter cake built with hot milk, under a cocoa frosting.",
  "serves": 16,
  "yield": "one two-layer 8\" or 9\" cake",
  "vessel": "two 8x2-in or 9x2-in round pans",
  "oven": "325°F (165°C)",
  "active": "1 hr",
  "time": "26–42 min bake",
  "source": "https://www.kingarthurbaking.com/recipes/classic-birthday-cake-recipe",
  "credit": "Adapted from King Arthur Baking's classic birthday cake.",
  "sections": [
    {
      "name": "cake",
      "prep": [
        "Grease the pans, line the bottoms with parchment rounds, grease again",
        "Preheat oven to 325°F (165°C)"
